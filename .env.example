# ==============================================================================
# Academic Path & Schedule Optimizer (APSO) — Ortam Değişkenleri Şablonu
# ==============================================================================

# PostgreSQL 16 Veritabanı Ayarları
POSTGRES_USER=apso_user
POSTGRES_PASSWORD=apso_secret_password
POSTGRES_DB=apso_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Bağlantı Dizesi (Docker Compose içinden veya yerel ortamdan)
DATABASE_URL=postgresql+psycopg://apso_user:apso_secret_password@localhost:5432/apso_db

# Uygulama ve Çözücü (CP-SAT) Yapılandırması
APP_ENV=development
AUTO_SEED_ON_STARTUP=true
CPSAT_MAX_TIME_SECONDS=25
CPSAT_NUM_SEARCH_WORKERS=8
